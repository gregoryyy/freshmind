{
  "name": "fm4",
  "version": "0.1.0",
  "author": "Gregor Heinrich",
  "license": "SEE LICENSE IN LICENSE",
  "description": "A TypeScript port of the classic Java graph browser API and spring embedder",
  "type": "module",
  "main": "./dist/tg/index.js",
  "types": "./dist/tg/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tg/index.d.ts",
      "import": "./dist/tg/index.js"
    },
    "./core": {
      "types": "./dist/tg/core.d.ts",
      "import": "./dist/tg/core.js"
    },
    "./tg": {
      "types": "./dist/tg/index.d.ts",
      "import": "./dist/tg/index.js"
    },
    "./tg/core": {
      "types": "./dist/tg/core.d.ts",
      "import": "./dist/tg/core.js"
    },
    "./fm": {
      "types": "./dist/fm/index.d.ts",
      "import": "./dist/fm/index.js"
    },
    "./fm/core": {
      "types": "./dist/fm/core.d.ts",
      "import": "./dist/fm/core.js"
    },
    "./fm/config": {
      "types": "./dist/fm/config/yaml.d.ts",
      "import": "./dist/fm/config/yaml.js"
    },
    "./fm/io": {
      "types": "./dist/fm/io/codec.d.ts",
      "import": "./dist/fm/io/codec.js"
    },
    "./fm/rfc": {
      "types": "./dist/fm/rfc/index.d.ts",
      "import": "./dist/fm/rfc/index.js"
    },
    "./fm/ui": {
      "types": "./dist/fm/ui/index.d.ts",
      "import": "./dist/fm/ui/index.js"
    },
    "./fm/ui/style.css": "./src/fm/ui/style.css",
    "./config/fm2014.types.yaml": "./config/fm2014.types.yaml"
  },
  "files": [
    "dist",
    "src",
    "config",
    "LICENSE",
    "LICENSE-APACHE-2.0",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:java": "npm run build && node scripts/java-reference.mjs",
    "test:browser": "playwright test",
    "prepack": "npm run build",
    "sync:fm-config": "node scripts/sync-fm-config.mjs",
    "prebuild": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\""
  },
  "dependencies": {
    "d3-drag": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
